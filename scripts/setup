#!/usr/bin/env bash
# Install everything needed to develop, test and lint, into the active
# virtual environment. Uses uv when it's installed (seconds), else pip.
# mysa-client comes from PyPI at the version pyproject.toml pins, as in CI.
# To develop against a local client checkout instead:
#   MYSA_CLIENT_PATH=../mysa-client scripts/setup
set -e
cd "$(dirname "$0")/.."
if command -v uv >/dev/null 2>&1; then
    install=(uv pip install)
else
    python3 -m pip install --upgrade pip
    install=(python3 -m pip install)
fi
"${install[@]}" --group dev --group lint
if [[ -n "${MYSA_CLIENT_PATH}" ]]; then
    "${install[@]}" --editable "${MYSA_CLIENT_PATH}[homekit,mqtt]"
fi
