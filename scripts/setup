#!/usr/bin/env bash
# Install everything needed to develop, test and lint.
set -e
cd "$(dirname "$0")/.."
python3 -m pip install --upgrade pip
client_wheel="${PWD}/../mysa-client/dist/mysa_client-0.1.0-py3-none-any.whl"
if [[ -f "${client_wheel}" ]]; then
    python3 -m pip install "mysa-client[homekit] @ file://${client_wheel}"
elif [[ -f "${PWD}/../mysa-client/pyproject.toml" ]]; then
    python3 -m pip install --editable "${PWD}/../mysa-client[homekit]"
else
    python3 -m pip install "mysa-client[homekit]==0.1.0"
fi
python3 -m pip install --group dev --group lint
